{
  "name": "portal-do-acordo-backend",
  "version": "1.0.0",
  "description": "Backend de dados do Portal do Acordo",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "dev:lan": "tsx watch src/index.ts",
    "benchmark:queries": "node --env-file=.env --import tsx scripts/benchmarkQueries.ts",
    "benchmark:queries:postgres": "node --env-file=.env --import tsx scripts/benchmarkQueries.ts --block=postgresql-principal",
    "benchmark:queries:communication": "node --env-file=.env --import tsx scripts/benchmarkQueries.ts --block=comunicacao-postgresql",
    "benchmark:queries:azure": "node --env-file=.env --import tsx scripts/benchmarkQueries.ts --block=azure-sql-cliques",
    "validate:costs": "node --env-file=.env --import tsx scripts/validateCostsAggregation.ts",
    "ddl:email-mensal": "node --env-file=.env --import tsx scripts/applyEmailMonthlyAggregateDdl.ts",
    "refresh:email-mensal": "node --env-file=.env --import tsx scripts/refreshEmailMonthlyAggregate.ts",
    "validate:email-mensal": "node --env-file=.env --import tsx scripts/validateEmailMonthlyAggregate.ts",
    "refresh:email-monthly-aggregate": "node --env-file=.env --import tsx scripts/refreshEmailMonthlyAggregate.ts",
    "validate:email-monthly-aggregate": "node --env-file=.env --import tsx scripts/validateEmailMonthlyAggregate.ts"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.0.0",
    "mssql": "^10.0.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
